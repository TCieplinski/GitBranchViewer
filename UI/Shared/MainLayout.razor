@inherits LayoutComponentBase

<div class="d-flex flex-column vh-100">
    <!-- Top Header -->
    <header class="navbar navbar-expand-lg navbar-dark bg-dark px-3">
        <a class="navbar-brand" href="#">Git Branch Viewer</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarCollapse">
            <span class="navbar-toggler-icon"></span>
        </button>
    </header>

    <div class="d-flex flex-grow-1">
        <!-- Sidebar -->
        <nav id="sidebarCollapse" class="bg-light border-end collapse d-lg-block sidebar">
            <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action" href="/">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
                <a class="list-group-item list-group-item-action" href="/branches">
                    <i class="bi bi-diagram-3 me-2"></i> View Branches
                </a>
                <a class="list-group-item list-group-item-action" href="/compare">
                    <i class="bi bi-arrow-left-right me-2"></i> Compare Branches
                </a>
                <a class="list-group-item list-group-item-action" href="/settings">
                    <i class="bi bi-gear me-2"></i> Settings
                </a>
                <a class="list-group-item list-group-item-action" href="/cheatshhet">
                    <i class="bi bi-journal-code me-2"></i> Git Cheatsheet
                </a>
                <a class="list-group-item list-group-item-action" href="/ssh">🔐 SSH Diagnostics</a>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="p-3 flex-fill overflow-auto">
            @Body
        </main>
    </div>
</div>

@code {
    // Additional logic if needed
}