@page "/settings"
@inject GitBranchViewer.Core.Services.SettingsService SettingsService

<h3>🔧 Application Settings</h3>
<p class="text-muted">This interface allows editing <code>user.settings.json</code> used by the application.</p>
<p>
    This settings file is stored at:<br />
    <code>%AppData%\GitBranchViewer\user.settings.json</code>
</p>

<div class="form-group">
    <label for="jsonInput">Your current <code>user.settings.json</code>:</label>
    <textarea class="form-control" id="jsonInput" rows="20" @bind="UserJson"></textarea>
</div>

<div class="mt-3">
    <button class="btn btn-primary" @onclick="LoadSettings">Load Settings</button>
    <button class="btn btn-outline-secondary ml-2" @onclick="ShowTemplate">📄 Show Template</button>
</div>

@if (!string.IsNullOrWhiteSpace(Feedback))
{
    <div class="alert @FeedbackClass" role="alert">
        @Feedback
    </div>
}

@code {
    private string UserJson = string.Empty;
    private string Feedback;
    private string FeedbackClass;

    protected override void OnInitialized()
    {
        try
        {
            UserJson = SettingsService.GetCurrentUserSettingsAsJson();
        }
        catch (Exception ex)
        {
            Feedback = $"❌ Failed to load settings: {ex.Message}";
            FeedbackClass = "alert-danger";
        }
    }

    private void LoadSettings()
    {
        try
        {
            SettingsService.LoadFromJson(UserJson);
            Feedback = "✅ Settings successfully loaded and saved.";
            FeedbackClass = "alert-success";
        }
        catch (Exception ex)
        {
            Feedback = $"❌ Failed to load settings: {ex.Message}";
            FeedbackClass = "alert-danger";
        }
    }

    private void ShowTemplate()
    {
        UserJson = SettingsService.GetJsonTemplate();
    }
}