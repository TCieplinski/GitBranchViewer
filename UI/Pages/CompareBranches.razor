@page "/compare"
@using GitBranchViewer.Core.Config
@using GitBranchViewer.Core.Services
@inject GitBranchViewer.Core.Services.SettingsService SettingsService
@inject NavigationManager NavManager
@inject IJSRuntime JS

<h3>🔍 Compare Branches</h3>

@if (SettingsService.Current.GitRepositories.Count == 0)
{
    <p>No repositories configured.</p>
}
else
{
    <div class="form-group">
        <label>Repository:</label>
        <select class="form-control" @bind="SelectedRepoName">
            <option value="">-- Select --</option>
            @foreach (var repo in SettingsService.Current.GitRepositories)
            {
                <option value="@repo.Name">@repo.Name</option>
            }
        </select>
    </div>

    @if (!string.IsNullOrWhiteSpace(SelectedRepoName))
    {
        <div class="form-group mt-3">
            <label>Branch A:</label>
            <select class="form-control" @bind="BranchA">
                <option value="">-- Select --</option>
                @foreach (var b in GetBranchesForSelectedRepo())
                {
                    <option value="@b">@b</option>
                }
            </select>

            <label class="mt-2">Branch B:</label>
            <select class="form-control" @bind="BranchB">
                <option value="">-- Select --</option>
                @foreach (var b in GetBranchesForSelectedRepo())
                {
                    <option value="@b">@b</option>
                }
            </select>
        </div>
    }

    @if (CanShowCompareMode)
    {
        <div class="form-group mt-4">
            <label>Compare Strategy:</label>
            <select class="form-control" @bind="CompareMode">
                <option value="">-- Choose Compare Mode --</option>
                <option value="Simple">Simple</option>
                <option value="Merge">Merge</option>
                <option value="Remote">Remote</option>
                <option value="Quick">Quick</option>
            </select>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(CompareMode))
    {
        <div class="mt-3">
            <button class="btn btn-primary" @onclick="LaunchComparisonPage">Compare</button>
            <button class="btn btn-outline-secondary ml-2" @onclick="ClearOptions">Clear Options</button>
        </div>
    }
}

@code {
    private string SelectedRepoName = string.Empty;
    private string BranchA = string.Empty;
    private string BranchB = string.Empty;
    private string CompareMode = string.Empty;

    private List<string> GetBranchesForSelectedRepo()
    {
        return SettingsService.Current
            .GitRepositories
            .FirstOrDefault(r => r.Name == SelectedRepoName)?
            .Branches
            .Select(b => b.Name)
            .Distinct()
            .ToList() ?? new List<string>();
    }

    private bool CanShowCompareMode =>
        !string.IsNullOrWhiteSpace(SelectedRepoName) &&
        !string.IsNullOrWhiteSpace(BranchA) &&
        !string.IsNullOrWhiteSpace(BranchB) &&
        BranchA != BranchB;

    private async Task LaunchComparisonPage()
    {
        var url = $"/compareResult?repo={Uri.EscapeDataString(SelectedRepoName)}&branchA={Uri.EscapeDataString(BranchA)}&branchB={Uri.EscapeDataString(BranchB)}&mode={CompareMode}";
        await JS.InvokeVoidAsync("window.open", url, "_blank");
    }
    private void ClearOptions()
    {
        SelectedRepoName = string.Empty;
        BranchA = string.Empty;
        BranchB = string.Empty;
        CompareMode = string.Empty;
    }
}