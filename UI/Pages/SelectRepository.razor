@page "/select"
@using GitBranchViewer.Core.Config
@using GitBranchViewer.Core.Services
@inject GitViewerSettings Settings
@inject IServiceProvider ServiceProvider
@inject NavigationManager NavManager

<h3>Select Repository</h3>

@if (Settings.GitRepositories.Count == 0)
{
    <p>No repositories configured.</p>
}
else
{
    <label>Repository:</label>
    <select @onchange="OnRepoChanged">
        <option disabled selected value="">-- Select --</option>
        @foreach (var repo in Settings.GitRepositories)
        {
            <option value="@repo.Name">@repo.Name</option>
        }
    </select>

    @if (Branches is not null)
    {
        <div class="mt-3">
            <label>Branch A:</label>
            <select @bind="BranchA">
                @foreach (var b in Branches)
                {
                    <option value="@b">@b</option>
                }
            </select>
            
            <label class="ml-3">Branch B:</label>
            <select @bind="BranchB">
                @foreach (var b in Branches)
                {
                    <option value="@b">@b</option>
                }
            </select>

            <div class="mt-3">
                <button class="btn btn-primary" @onclick="CompareBranches" disabled="@IsCompareDisabled">Compare</button>
            </div>
        </div>
    }
}

@code {
    private string SelectedRepoName;
    private List<string> Branches;
    private string BranchA;
    private string BranchB;

    private bool IsCompareDisabled =>
        string.IsNullOrWhiteSpace(SelectedRepoName) ||
        string.IsNullOrWhiteSpace(BranchA) ||
        string.IsNullOrWhiteSpace(BranchB) ||
        BranchA == BranchB;

    private void OnBranchAChanged(ChangeEventArgs e)
    {
        BranchA = e.Value?.ToString();
        StateHasChanged();
    }

    private void OnBranchBChanged(ChangeEventArgs e)
    {
        BranchB = e.Value?.ToString();
        StateHasChanged();
    }

    private void OnRepoChanged(ChangeEventArgs e)
    {
        SelectedRepoName = e.Value?.ToString();
        var repo = Settings.GitRepositories.FirstOrDefault(r => r.Name == SelectedRepoName);
        if (repo is null)
        {
            Branches = null;
            BranchA = BranchB = null;
            return;
        }

        var git = new GitService(repo.Path);
        Branches = git.GetBranches();
        //Initialize with two valid, distinct branches (if possible)
        BranchA = Branches.Count > 0 ? Branches[0] : null;
        BranchB = Branches.Count > 1 ? Branches[1] : BranchA;

        StateHasChanged();  // force UI refresh
    }

    private void CompareBranches()
    {
        var url = $"/compare?repo={Uri.EscapeDataString(SelectedRepoName)}&branchA={Uri.EscapeDataString(BranchA)}&branchB={Uri.EscapeDataString(BranchB)}";
        NavManager.NavigateTo(url);
    }
}