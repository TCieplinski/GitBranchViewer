@page "/branches"
@using GitBranchViewer.Core.Config
@inject GitBranchViewer.Core.Services.SettingsService SettingsService

<h3><i class="bi bi-diagram-3"></i> Branches</h3>
<p class="text-muted">These branches are listed from <code>user.appsettings.json</code>.</p>

<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Repository</th>
            <th>Type</th>
            <th>Details</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entry in GetBranchTableEntries())
        {
            <tr>
                <td>@entry.Name</td>
                <td>@entry.Repository</td>
                <td>@entry.Type</td>
                <td>@entry.Path</td>
                <td>
                    <div class="btn-group">
                        <button class="btn btn-sm btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            Actions
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Details</a></li>
                            <li><a class="dropdown-item" href="#">Compare</a></li>
                            <li><a class="dropdown-item text-danger" href="#">Delete</a></li>
                        </ul>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private record BranchRow(string Name, string Repository, string Type, string Path);

    private List<BranchRow> GetBranchTableEntries()
    {
        return SettingsService.Current.GitRepositories
            .SelectMany(repo => repo.Branches.Select(bt => new BranchRow(bt.Name, repo.Name, bt.Type, bt.Path)))
            .OrderBy(x => x.Repository)
            .ThenBy(x => x.Name)
            .ToList();
    }
}